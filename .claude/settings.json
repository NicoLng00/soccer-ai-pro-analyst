{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run sap *)",
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic revision *)",
      "Bash(uv run alembic current *)",
      "Bash(uv run alembic history *)",
      "Bash(uv run dagster *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(./scripts/dev-up.sh)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npm --prefix frontend ci)",
      "Bash(npx --prefix frontend playwright test *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose down *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(npm install *)",
      "Bash(npm --prefix frontend install *)",
      "Bash(nmap *)",
      "Bash(ffuf *)",
      "Bash(nuclei *)",
      "Bash(sqlmap *)",
      "Bash(nikto *)",
      "Bash(testssl.sh *)",
      "Bash(docker run * zaproxy/*)",
      "Bash(zap-baseline.py *)",
      "Bash(zap-api-scan.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/quick-check.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
