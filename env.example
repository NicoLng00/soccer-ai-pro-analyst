# Copia in .env e cambia tutte le password. .env non va mai nel repository
# e Claude Code non lo legge (permessi e hook lo bloccano).
# Non esportare .env nella shell da cui avvii Claude Code: usa ./scripts/claude.sh,
# che passa alla sessione solo SAP_ENV e SAP_DB_URL_READONLY. Con SAP_ENV=dev i
# processi Python leggono .env da soli (core/config.py); dev-up.sh lo carica per sé.

SAP_ENV=dev

# --- PostgreSQL -------------------------------------------------------------
# Superutente del container: serve solo a creare i ruoli (scripts/provision_roles.py).
POSTGRES_PASSWORD=cambia-superutente
SAP_DB_URL_ADMIN=postgresql://postgres:cambia-superutente@localhost:5432/sap

# Un URL per ruolo, in forma libpq (postgresql://). Le password scritte qui sono
# quelle che provision_roles.py assegna ai ruoli: sono l'unica copia.
SAP_DB_URL_OWNER=postgresql://sap_owner:cambia-owner@localhost:5432/sap
SAP_DB_URL_LIVE=postgresql://sap_live:cambia-live@localhost:5432/sap
SAP_DB_URL_BACKFILL=postgresql://sap_backfill:cambia-backfill@localhost:5432/sap
# Solo `sap registry sync`: scrive ops.source e obs.variable, nient'altro.
SAP_DB_URL_REGISTRY=postgresql://sap_registry:cambia-registry@localhost:5432/sap
# Usato anche dal server MCP postgres-ro di Claude Code (.mcp.json).
SAP_DB_URL_READONLY=postgresql://sap_readonly:cambia-readonly@localhost:5432/sap
# Area amministrativa (fase 6). Il container dell'API riceve solo SAP_DB_URL_API;
# SAP_DB_URL_USERADMIN serve solo ai comandi `sap admin` da terminale.
SAP_DB_URL_API=postgresql://sap_api:cambia-api@localhost:5432/sap
SAP_DB_URL_USERADMIN=postgresql://sap_useradmin:cambia-useradmin@localhost:5432/sap

# --- Raw store (S3 compatibile) --------------------------------------------
# Sviluppo: SeaweedFS in Docker. Produzione: Cloudflare R2.
SAP_RAW_ENDPOINT_URL=http://localhost:8333
SAP_RAW_REGION=auto
SAP_RAW_BUCKET=sap-raw
SAP_RAW_ACCESS_KEY_ID=sap-dev
SAP_RAW_SECRET_ACCESS_KEY=cambia-s3

# --- API esterne (piani gratuiti) -------------------------------------------
SAP_API_FOOTBALL_KEY=
SAP_THE_ODDS_API_KEY=
SAP_ODDSPAPI_KEY=
SAP_FOOTBALL_DATA_ORG_TOKEN=

# --- Agenti runtime (fase 4) -------------------------------------------------
# Piano gratuito Gemini: i contenuti possono essere usati da Google per migliorare
# i propri prodotti. Mandare solo testo pubblico (notizie), mai dati di clienti.
SAP_GEMINI_API_KEY=

# --- Area amministrativa (fase 6) --------------------------------------------
# Chiave per cifrare i segreti TOTP nel database (32 byte casuali in base64).
SAP_TOTP_ENCRYPTION_KEY=
# Origine del frontend ammessa da CORS e dal controllo di Origin.
SAP_WEB_ORIGIN=http://localhost:5173
# Cloudflare Access: team domain e audience dell'applicazione (vuoti in sviluppo).
SAP_CF_ACCESS_TEAM_DOMAIN=
SAP_CF_ACCESS_AUD=

# --- Orchestrazione ---------------------------------------------------------
DAGSTER_HOME=.dagster
